---
import MainLayout from "../layouts/mainLayout.astro"
import { GithubAnalytics } from "../components/GithubAnalytics/GithubAnalytics"
import { MyTechStacks } from "../components/MyTechStacks/MyTechStacks"
import { FeaturedProjects } from "../components/FeaturedProjects/FeaturedProjects"
import type { ProjectCardProps } from "../components/ProjectCard/types"
import { getFeatureProjects } from "../services/github"
import { Cache } from '../database/Cache/cache'
import "../styles/pages/home.scss"

const cache = new Cache()

async function getData() {
	const cacheID = "home:features"
	const cacheData = await cache.hget(cacheID)

	if (cacheData) {
		return cacheData as ProjectCardProps[]
	}

	const projects: ProjectCardProps[] = await getFeatureProjects()
	await cache.hset(cacheID, projects, 3600)

	return projects
}

const projects = await getData();
---

<MainLayout title={"Home"}>
	<section class="home-hero glass-panel mb-8 rounded-2xl p-6 md:p-8">
		<p class="mb-2 text-sm font-medium uppercase tracking-widest text-accent">Portfolio</p>
		<h1 class="mb-3 text-3xl font-bold tracking-tight md:text-4xl">
			Building <span class="section-heading-accent">polished interfaces</span> with modern web &amp; Rust
		</h1>
		<p class="max-w-2xl text-sm leading-relaxed text-gray-400 md:text-base">
			Selected work from GitHub — Astro, React, TypeScript, Rust, and Tauri, with a focus on UX and performance.
		</p>
	</section>
	<GithubAnalytics client:load />
	<FeaturedProjects projects={projects} />
	<MyTechStacks client:load/>
</MainLayout>
